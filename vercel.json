{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "buildCommand": "npm run build",
        "outputDirectory": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/agreement/accept",
      "dest": "/api/index.ts"
    },
    {
      "src": "/api/admin/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/api/supervisor/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/api/support/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
